{
    "name": "lionweb-repo-admin-ui",
    "private": true,
    "version": "0.3.0",
    "type": "module",
    "scripts": {
        "server": "docker-compose up",
        "setup": "node scripts/reposetup.js",
        "dev": "echo def from package.json && vite dev",
        "build": "echo build from package.json && vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint-fix": "npx eslint 'src/**/*.ts' --fix && prettier --write src/**/*.ts",
        "lint-check": "npx eslint 'src/**/*.ts' && prettier --check src/**/*.ts",
        "release": "release-it",
        "install2": "nmp install",
        "install-local": "npm install --registry http://localhost:4873",
        "check-dependencies": "npx  syncpack lint --source 'package.json' --source 'packages/*/package.json'",
        "list-dependencies": "npx  syncpack list --source 'package.json' --source 'packages/*/package.json'"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@sveltejs/adapter-auto": "7.0.1",
        "@sveltejs/kit": "2.69.3",
        "@sveltejs/vite-plugin-svelte": "7.1.2",
        "@tailwindcss/typography": "0.5.20",
        "@tailwindcss/vite": "4.2.4",
        "@typescript-eslint/eslint-plugin": "^8.26.1",
        "@typescript-eslint/parser": "^8.26.1",
        "eslint": "^9.22.0",
        "globals": "16.5.0",
        "prettier": "3.9.5",
        "prettier-plugin-svelte": "4.1.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "release-it": "^18.1.2",
        "rollup": "4.62.2",
        "svelte": "5.56.4",
        "svelte-check": "4.7.3",
        "tailwindcss": "4.2.4",
        "typescript": "5.9.3",
        "typescript-eslint": "8.59.2",
        "vite": "8.1.3"
    },
    "dependencies": {
        "@fortawesome/free-solid-svg-icons": "7.3.1",
        "@fortawesome/svelte-fontawesome": "0.2.4",
        "@humanspeak/svelte-json-view-lite": "0.2.1",
        "@lionweb/core": "0.10.0",
        "@lionweb/server-delta-client": "0.4.2-beta.3",
        "@lionweb/server-delta-definitions": "0.4.2-beta.3",
        "@lionweb/server-delta-shared": "0.4.2-beta.3",
        "@lionweb/server-http-client": "0.4.2-beta.3",
        "@lionweb/server-shared": "0.4.2-beta.3",
        "@lionweb/validation": "0.10.0",
        "@logtape/file": "2.0.5",
        "@logtape/logtape": "2.0.5",
        "@logtape/pretty": "2.0.5",
        "@lucide/svelte": "1.24.0",
        "@skeletonlabs/skeleton-svelte": "4.15.2",
        "@types/jszip": "3.4.1",
        "@xyflow/svelte": "1.6.2",
        "jszip": "3.10.1",
        "svelte-heros": "8.0.1",
        "svelte-language-server": "^0.18.3"
    }
}
